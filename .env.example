# MONGODB_URI: MongoDB Atlas connection string (server-side only)
# Format: mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/foodlens?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/foodlens?retryWrites=true&w=majority"

# JWT_SECRET: Strong secret key for signing authentication tokens (min 16 characters in production)
JWT_SECRET="replace_with_a_long_secure_random_secret"

# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Product providers
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org/api/v2

# UPCitemdb FREE tier (optional API key for higher rate limits)
SECONDARY_PRODUCT_API_URL=https://api.upcitemdb.com/prod/trial/lookup
SECONDARY_PRODUCT_API_KEY=

# USDA FoodData Central (optional API key for high volume enrichment)
USDA_API_BASE_URL=https://api.nal.usda.gov/fdc/v1
USDA_API_KEY=

